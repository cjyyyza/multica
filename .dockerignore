# Dockerfile.web needs the web workspace and patches declared in the root
# package manifest. Exclude other app sources from the build context.
/apps/*
!/apps/web/
!/apps/mobile/
/apps/mobile/*
!/apps/mobile/patches/

# Repository-only tooling
/.github/
/deploy/
/scripts/**
!/scripts/vitest-platform.mjs
!/scripts/vitest-platform.d.mts
